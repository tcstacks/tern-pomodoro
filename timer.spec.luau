--!strict
-- Run with `luau timer.spec.luau`, or require("./timer.spec") in a Tern host VM.
local function run()
    local Timer = require("./timer")
    local state = Timer.restore(nil)
    Timer.toggle(state, 1000)
    assert(Timer.remaining(state, 1061) == 1439, "running time follows the deadline")
    Timer.toggle(state, 1061)
    assert(state.deadline == nil and Timer.remaining(state, 2000) == 1439, "pause freezes time")
    Timer.toggle(state, 3000)
    assert(state.deadline == 4439, "resume keeps the unspent time")

    local restored = Timer.restore(Timer.save(state))
    assert(Timer.remaining(restored, 4400) == 39, "reload preserves the original deadline")
    assert(not Timer.settle(restored, 4438), "cannot finish before the deadline")
    assert(Timer.settle(restored, 4439), "finishes exactly at the deadline")
    assert(restored.completed == 1 and restored.remaining == 0 and restored.deadline == nil, "finish waits for user")
    assert(not Timer.settle(restored, 9000) and restored.completed == 1, "late callbacks cannot count twice")
    Timer.toggle(restored, 9000)
    assert(restored.phase == "break" and restored.deadline == 9300, "completion starts a fresh break only on request")
    assert(Timer.settle(restored, 10000) and restored.completed == 1, "breaks do not count as focus sessions")
    Timer.toggle(restored, 11000)
    assert(restored.phase == "focus" and restored.deadline == 12500, "break completion returns to focus")

    Timer.next(restored)
    assert(restored.phase == "break" and restored.deadline == nil and restored.remaining == 300 and restored.completed == 1, "skip does not award a session or auto-start")
    Timer.select(restored, "focus")
    Timer.toggle(restored, 12000)
    Timer.select(restored, "focus")
    assert(restored.remaining == 1500 and restored.deadline == nil, "reset cancels a running interval")

    local sleeping = Timer.restore({ phase = "focus", remaining = 1500, deadline = 10, completed = 2 })
    assert(Timer.settle(sleeping, 100000) and sleeping.completed == 3, "wake or restart completes one interval, not phantom cycles")
    local race = Timer.restore({ phase = "focus", remaining = 1500, deadline = 10, completed = 0 })
    Timer.toggle(race, 10)
    assert(race.completed == 1 and race.phase == "break" and race.deadline == 310, "input at expiry cannot resume an expired focus interval")
    local other = Timer.restore(nil)
    assert(other.completed == 0 and other.deadline == nil, "blocks do not share timer state")

    local custom = Timer.restore(nil)
    assert(Timer.set_duration(custom, 1), "shortest focus can be selected")
    Timer.toggle(custom, 500)
    assert(custom.deadline == 560 and Timer.remaining(custom, 530) == 30, "custom duration drives the deadline")
    assert(Timer.settle(custom, 560) and custom.completed == 1, "custom focus counts exactly once")
    Timer.next(custom)
    assert(Timer.set_duration(custom, 180), "longest break can be selected")
    Timer.toggle(custom, 1000)
    local savedCustom = Timer.restore(Timer.save(custom))
    assert(savedCustom.deadline == 11800 and Timer.remaining(savedCustom, 1100) == 10700, "long custom intervals survive reload without the old clamp")
    Timer.select(savedCustom, "focus")
    assert(savedCustom.remaining == 60, "phase durations are independent")
    Timer.select(savedCustom, "break")
    assert(savedCustom.remaining == 10800, "reset uses the saved custom duration")
    for _, invalid in { 0, -1, 181, 1.5, math.huge, 0 / 0 } do
        assert(not Timer.set_duration(savedCustom, invalid), "invalid durations are rejected")
        assert(savedCustom.remaining == 10800 and savedCustom.completed == 1, "rejection leaves the interval unchanged")
    end
    Timer.toggle(savedCustom, 2000)
    assert(Timer.set_duration(savedCustom, 10), "applying a new duration succeeds")
    assert(savedCustom.deadline == nil and savedCustom.remaining == 600 and savedCustom.completed == 1, "editing prepares an idle interval without awarding a session")
    print("Pomodoro timer: transition assertions passed")
end

run()
return true
